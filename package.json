{
  "name": "homekit-cli",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l3wi/homekit-cli.git"
  },
  "homepage": "https://github.com/l3wi/homekit-cli#readme",
  "bugs": {
    "url": "https://github.com/l3wi/homekit-cli/issues"
  },
  "bin": {
    "homekit": "dist/bin.js"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "incur": "^0.4.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
