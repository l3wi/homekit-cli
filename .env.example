# Copy to .env.local or .env and fill in local signing values.
# Do not commit real Apple team IDs, certificate names, notary profiles, or profile names.

# Development builds
HOMEKIT_DEVELOPMENT_TEAM=
HOMEKIT_PROVISIONING_PROFILE_SPECIFIER=
XCODE_ALLOW_PROVISIONING_UPDATES=1

# Developer ID release builds
HOMEKIT_TEAM_ID=
HOMEKIT_DISTRIBUTION_PROFILE_SPECIFIER=
HOMEKIT_DEVELOPER_ID_APPLICATION=
HOMEKIT_DEVELOPER_ID_INSTALLER=
HOMEKIT_NOTARY_KEYCHAIN_PROFILE=

# Local release debugging only. Never publish artifacts built with this set to 1.
HOMEKIT_SKIP_NOTARY=0

# Runtime/dev socket overrides
HOMEKIT_USE_TMP_SOCKET=
HOMEKIT_SOCKET_PATH=
HOMEKIT_APP_GROUP_IDENTIFIER=
HOMEKIT_MCP_PROFILE=
